{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShippingDatabase": "Server=(localdb)\\mssqllocaldb;Database=ShippingPlatform;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<eurofins-azure-ad-tenant-id>",
    "ClientId": "<shipping-platform-api-app-registration-client-id>",
    "Audience": "api://shipping-platform-api"
  },
  "D365": {
    "TenantId": "<eurofins-azure-ad-tenant-id>",
    "ClientId": "<d365-integration-app-registration-client-id>",
    "ClientSecret": "<use-azure-key-vault-or-user-secrets-do-not-commit>",
    "ResourceUrl": "https://eurofins.operations.dynamics.com",
    "ODataPath": "/data",
    "MaxSyncAttempts": 5
  },
  "Carriers": {
    "Dhl": { "BaseUrl": "https://api-sandbox.dhl.com/" },
    "Ups": { "BaseUrl": "https://wwwcie.ups.com/" },
    "Nitsu": { "BaseUrl": "https://sandbox.nitsu.example/" }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
